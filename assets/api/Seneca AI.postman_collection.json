		{
			"name": "Chat",
			"description": "The API calls the LLM (LLM_PROVIDER of the api container) and streams the reply as Server-Sent Events. See docs/chat-api.md.",
			"item": [
				{
					"name": "chat capabilities",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/chat/capabilities",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"chat",
								"capabilities"
							]
						},
						"description": "Provider, model and whether the model supports tool calling."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.test('has tool_calling', () => pm.expect(pm.response.json()).to.have.property('tool_calling'));"
								]
							}
						}
					]
				},
				{
					"name": "chat (new conversation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"// The body is a stream of Server-Sent Events: 'event: <name>' + 'data: <json>'",
									"const events = pm.response.text().trim().split('\\n\\n').map(block => {",
									"    const lines = block.split('\\n');",
									"    const name = (lines.find(l => l.startsWith('event:')) || '').slice(6).trim();",
									"    const data = (lines.find(l => l.startsWith('data:')) || 'data: {}').slice(5).trim();",
									"    return { event: name, data: JSON.parse(data) };",
									"});",
									"pm.test('first event is conversation', () => pm.expect(events[0].event).to.eql('conversation'));",
									"pm.collectionVariables.set('CONVERSATION_ID', events[0].data.id);",
									"const last = events[events.length - 1];",
									"pm.test('ends with done or tool_calls', () => pm.expect(['done', 'tool_calls']).to.include(last.event));",
									"if (last.event === 'tool_calls') {",
									"    pm.collectionVariables.set('TOOL_CALL_ID', last.data.tool_calls[0].id);",
									"}",
									"console.log(events.filter(e => e.event === 'token').map(e => e.data.text).join(''));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
