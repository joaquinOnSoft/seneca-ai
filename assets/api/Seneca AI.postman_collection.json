		{
			"name": "Conversations",
			"description": "Authenticated with the API key + X-SENECA-AI-USER-ID header. To use a JWT instead, replace both headers with `Authorization: Bearer {{ACCESS_TOKEN}}` (see *list conversations (JWT)*).",
			"item": [
				{
					"name": "create conversation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations"
							]
						},
						"description": "Creates a conversation. Returns 201 with the conversation and a Location header. Saves the new id in CONVERSATION_ID.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Estoicismo\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hola Séneca, ¿qué es el estoicismo?\",\n      \"timestamp\": \"2026-01-01T10:00:00+00:00\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Una escuela filosófica fundada por Zenón de Citio.\",\n      \"timestamp\": \"2026-01-01T10:00:05+00:00\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
