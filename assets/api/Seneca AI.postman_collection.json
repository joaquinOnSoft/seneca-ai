		{
			"name": "Auth",
			"item": [
				{
					"name": "login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/auth/login",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Returns an access token (JWT) and a refresh token. Saves them in ACCESS_TOKEN and REFRESH_TOKEN.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{USERNAME}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const data = pm.response.json();",
									"pm.collectionVariables.set('ACCESS_TOKEN', data.access_token);",
									"pm.collectionVariables.set('REFRESH_TOKEN', data.refresh_token);"
								]
							}
						}
					]
				},
				{
					"name": "refresh",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{REFRESH_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/auth/refresh",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Returns a new access token using the refresh token. Updates ACCESS_TOKEN."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('ACCESS_TOKEN', pm.response.json().access_token);"
								]
							}
						}
					]
				},
				{
					"name": "logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{REFRESH_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/auth/logout",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Revokes the refresh token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Conversations",
			"description": "Authenticated with the API key + X-SENECA-AI-USER-ID header. To use a JWT instead, replace both headers with `Authorization: Bearer {{ACCESS_TOKEN}}` (see *list conversations (JWT)*).",
			"item": [
				{
					"name": "create conversation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations"
							]
						},
						"description": "Creates a conversation. Returns 201 with the conversation and a Location header. Saves the new id in CONVERSATION_ID.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Estoicismo\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hola Séneca, ¿qué es el estoicismo?\",\n      \"timestamp\": \"2026-01-01T10:00:00+00:00\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Una escuela filosófica fundada por Zenón de Citio.\",\n      \"timestamp\": \"2026-01-01T10:00:05+00:00\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"pm.collectionVariables.set('CONVERSATION_ID', pm.response.json()._id);"
								]
							}
						}
					]
				},
				{
					"name": "list conversations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations?convPerPage=20&numPage=1&includeMessages=false",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations"
							],
							"query": [
								{
									"key": "convPerPage",
									"value": "20",
									"description": "Conversations per page (1-100). Default 20"
								},
								{
									"key": "numPage",
									"value": "1",
									"description": "Page number (1-based). Default 1"
								},
								{
									"key": "includeMessages",
									"value": "false",
									"description": "Include the messages of each conversation"
								}
							]
						},
						"description": "Paginated list, newest first. Without messages unless includeMessages=true."
					},
					"response": []
				},
				{
					"name": "list conversations (JWT)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{ACCESS_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations?convPerPage=20&numPage=1",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations"
							],
							"query": [
								{
									"key": "convPerPage",
									"value": "20"
								},
								{
									"key": "numPage",
									"value": "1"
								}
							]
						},
						"description": "Same as *list conversations*, authenticated with the access token from *login*."
					},
					"response": []
				},
				{
					"name": "get conversation",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations/{{CONVERSATION_ID}}",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations",
								"{{CONVERSATION_ID}}"
							]
						},
						"description": "Conversation with all its messages. 403 if it belongs to another user, 404 if it does not exist."
					},
					"response": []
				},
				{
					"name": "update conversation",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations/{{CONVERSATION_ID}}",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations",
								"{{CONVERSATION_ID}}"
							]
						},
						"description": "Changes the title and/or replaces the whole messages array (both optional).",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Estoicismo (Séneca)\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "append messages",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations/{{CONVERSATION_ID}}/messages",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations",
								"{{CONVERSATION_ID}}",
								"messages"
							]
						},
						"description": "Appends messages at the end of the conversation without sending it again.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"¿Y quién fue Séneca?\",\n      \"timestamp\": \"2026-01-01T10:01:00+00:00\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Un filósofo estoico cordobés.\",\n      \"timestamp\": \"2026-01-01T10:01:04+00:00\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "delete conversation",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-SENECA-AI-API-KEY",
								"value": "{{X-SENECA-AI-API-KEY}}",
								"type": "text"
							},
							{
								"key": "X-SENECA-AI-USER-ID",
								"value": "{{USER_ID}}",
								"type": "text",
								"description": "Optional: user on whose behalf the API key acts. Without it: api_key_user"
							}
						],
						"url": {
							"raw": "{{HOST}}/senecaai/v1/conversations/{{CONVERSATION_ID}}",
							"host": [
								"{{HOST}}"
							],
							"path": [
								"senecaai",
								"v1",
								"conversations",
								"{{CONVERSATION_ID}}"
							]
						},
						"description": "Deletes the conversation. Returns 204 No Content."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('204 No Content', () => pm.response.to.have.status(204));"
								]
							}
						}
					]
				}
			]
		}
	],
