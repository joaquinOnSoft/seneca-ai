# LLM Provider (openai, ollama, anthropic)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama4

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# App settings
APP_LOCALE=es_ES
MAX_CONVERSATIONS=20

# ----------------------------
# Faster-whisper configuration
# ----------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
# Change to "cuda" if you have a compatible GPU
WHISPER_DEVICE=cpu
# int8 = faster on CPU; float16 for GPU
WHISPER_COMPUTE_TYPE=int8

# ----------------------------
# Speech to text backend model
# ----------------------------
# faster-whisper (local) | google
STT_BACKEND=faster-whisper


# Seneca API server
SENECA_API_BASE_URL=http://localhost:1414
SENECA_AI_API_KEY=your_seneca_api_key_here