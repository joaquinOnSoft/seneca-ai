# ----------------------------
# Chat LLM
# ----------------------------
# The Seneca AI API server calls the LLM (POST /senecaai/v1/chat); the desktop
# app only talks to the API. docker compose passes these values to the api
# container, so restart it after changing them: docker compose up -d
# LLM Provider (openai, ollama, anthropic)
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, no key needed).
# OLLAMA_BASE_URL is only used when the API runs outside Docker; the api
# container always uses http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hadad/LFM2.5-1.2B:Q4_K_M

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# App settings
APP_LOCALE=es_ES
# Number of conversations shown in the sidebar (the API returns at most 100 per page)
MAX_CONVERSATIONS=20
# Seconds the desktop app waits for the next chunk of a reply (the first one
# can take long while Ollama loads the model)
CHAT_READ_TIMEOUT=300

# ----------------------------
# Faster-whisper configuration
# ----------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
# Change to "cuda" if you have a compatible GPU
WHISPER_DEVICE=cpu
# int8 = faster on CPU; float16 for GPU
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK=1024
AUDIO_CHANNELS=1
# 16kHz for Whisper
AUDIO_RATE=16000

# ----------------------------
# Speech to text backend model
# ----------------------------
# faster-whisper (local) | google
STT_BACKEND=faster-whisper

# Seneca API server
SENECA_API_BASE_URL=http://localhost:1414
SENECA_AI_API_KEY=your_seneca_api_key_here
# Secret used to sign the JWT access tokens (required, also to run the tests).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
# User that owns the conversations saved by the desktop app through the API.
# If empty, the API stores them under the generic user "api_key_user".
SENECA_USER_ID=
# ----------------------------
# Docker
# ----------------------------
# MTU of the containers' network (llm_net). Lower it to the VPN's MTU when the
# host uses a VPN with a smaller one (e.g. 1280 for WireGuard VPNs such as
# Surfshark); otherwise HTTPS from the containers hangs (e.g. the Whisper model
# download). Check it with: ip link   (look at the VPN interface's "mtu")
DOCKER_NETWORK_MTU=1500
# Host folder for the Hugging Face cache (Whisper model) of the api container
# HF_CACHE_PATH=/opt/senecaai/volumes/huggingface
