# ----------------------------
# Chat LLM
# ----------------------------
# The Seneca AI API server calls the LLM (POST /senecaai/v1/chat); the desktop
# app only talks to the API. docker compose passes these values to the api
# container, so restart it after changing them: docker compose up -d
# LLM Provider (openai, ollama, anthropic)
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, no key needed).
# OLLAMA_MODEL is the chat model: the ollama container pulls it on start and
# the api uses it. If it is not set here, the OLLAMA_MODEL environment variable
# is used. The installers (select_ollama_model.sh/.ps1) suggest one from your
# RAM and write it here when it is empty or missing.
OLLAMA_MODEL=
# Only used when the API runs outside Docker (the containers use http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Stored messages sent to the LLM as context (most recent ones)
CHAT_HISTORY_MAX_MESSAGES=50
# API server threads: each streamed reply keeps one busy until it ends
API_THREADS=16

# ----------------------------
# Long-term memory
# ----------------------------
# The api searches the user's past conversations (indexed into Qdrant by the
# memory-worker container) and adds the related passages to the prompt.
# See docs/memory.md. Apply changes with: docker compose up -d
MEMORY_ENABLED=true
# Ollama embedding model (multilingual). Changing it re-indexes everything.
EMBEDDING_MODEL=bge-m3
# Most passages added to the prompt, and their minimum similarity (0-1)
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.5
# Size of the memory block in the prompt, in characters (~4 per token)
MEMORY_MAX_CHARS=4000
# Seconds the chat waits for the memory search before answering without it
MEMORY_SEARCH_TIMEOUT=3
# Update the summary of a conversation every N turns (0 = never)
MEMORY_SUMMARY_EVERY_TURNS=6
# Only used when the API runs outside Docker (the containers use http://qdrant:6333)
QDRANT_URL=http://localhost:6333
# Worker tuning (seconds): wait when idle, and between clean-ups of deleted conversations
# MEMORY_WORKER_INTERVAL=5
# MEMORY_CLEANUP_INTERVAL=600

# App settings
APP_LOCALE=es_ES
# Number of conversations shown in the sidebar (the API returns at most 100 per page)
MAX_CONVERSATIONS=20
# Seconds the desktop app waits for the next chunk of a reply (the first one
# can take long while Ollama loads the model)
CHAT_READ_TIMEOUT=300

# ----------------------------
# Faster-whisper configuration
# ----------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
# Change to "cuda" if you have a compatible GPU
WHISPER_DEVICE=cpu
# int8 = faster on CPU; float16 for GPU
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK=1024
AUDIO_CHANNELS=1
# 16kHz for Whisper
AUDIO_RATE=16000

# ----------------------------
# Speech to text backend model
# ----------------------------
# faster-whisper (local) | google
STT_BACKEND=faster-whisper

# Seneca API server
SENECA_API_BASE_URL=http://localhost:1414
# Must match docker/api/seneca_ai_api_key.txt; generate_secrets.sh/.ps1 copy it here
SENECA_AI_API_KEY=your_seneca_api_key_here
# Secret used to sign the JWT access tokens (required, also to run the tests).
# Only for the API run outside Docker: the api container reads
# docker/api/jwt_secret_key.txt. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
# User that owns the conversations saved by the desktop app through the API.
# If empty, the API stores them under the generic user "api_key_user".
SENECA_USER_ID=
# Optional Hugging Face token: higher rate limits when downloading the Whisper model
# HF_TOKEN=

# ----------------------------
# Docker
# ----------------------------
# MTU of the containers' network (llm_net). Lower it to the VPN's MTU when the
# host uses a VPN with a smaller one (e.g. 1280 for WireGuard VPNs such as
# Surfshark); otherwise HTTPS from the containers hangs (e.g. the Whisper model
# download). Check it with: ip link   (look at the VPN interface's "mtu")
DOCKER_NETWORK_MTU=1500
# Host folders of the volumes (defaults under /opt/senecaai/volumes; the
# Windows installer sets them to C:\ProgramData\senecaai\volumes\...)
# OLLAMA_MODELS_PATH=/opt/senecaai/volumes/ollama
# MONGODB_DATA_PATH=/opt/senecaai/volumes/mongo
# Host folder for the Hugging Face cache (Whisper model) of the api container
# HF_CACHE_PATH=/opt/senecaai/volumes/huggingface
# Host folder of the Qdrant index (long-term memory)
# QDRANT_STORAGE_PATH=/opt/senecaai/volumes/qdrant
